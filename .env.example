# --- PayPal SANDBOX credentials (never put live credentials here) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Default is the sandbox API. The proxy refuses any other host unless started with --i-know-this-is-live.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# --- PayLeash ---
# Directory with owner.pub.pem / stepup.key.pem etc. (created by `payleash keys init`). Must be outside the repo.
PAYLEASH_KEY_DIR=
PAYLEASH_DB_PATH=./payleash.db
# Bearer token the owner uses for POST /approvals/:id, /freeze, /unfreeze
PAYLEASH_OWNER_TOKEN=
# Mandate for the agent (stdio transport only; HTTP clients send it as Authorization: Bearer <mandate>)
PAYLEASH_MANDATE=
# PAYLEASH_MANDATE_FILE=

# --- Optional LLM for one-sentence explanations (decisions never depend on it) ---
CF_ACCOUNT_ID=
CF_API_TOKEN=
# CF_MODEL=@cf/meta/llama-3.1-8b-instruct
# Any other OpenAI-compatible endpoint:
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# --- Dashboard (served by the proxy: `payleash-proxy --transport http --dashboard apps/dashboard/dist`) ---
# Login for the dashboard is PAYLEASH_OWNER_TOKEN above. Cookies are httpOnly + SameSite=Strict.
# PAYLEASH_DASHBOARD_DIR=apps/dashboard/dist
# Where the dashboard is reachable from outside (links in notification emails). Render sets RENDER_EXTERNAL_URL itself.
# PAYLEASH_PUBLIC_URL=https://payleash.example.com
# Behind a TLS-terminating proxy (Render, nginx): trust X-Forwarded-Proto / X-Forwarded-For for the Secure cookie and login throttle.
# PAYLEASH_TRUST_PROXY=1

# Public demo (`--demo`): recorded PayPal, throw-away keys, in-memory database, seeded activity.
# Read-only judge login: it can look at everything and approve/deny only the seeded demo calls. The value is public by design.
# PAYLEASH_DEMO_TOKEN=judge-demo-2026

# Web Push for new held calls. Generate once, outside the repo:  pnpm payleash vapid init --subject mailto:you@example.com
# Hosts without a persistent disk can use these instead of the key directory's vapid.json:
# PAYLEASH_VAPID_PUBLIC=
# PAYLEASH_VAPID_PRIVATE=
# PAYLEASH_VAPID_SUBJECT=mailto:you@example.com

# Optional email link when no browser could be notified (Resend free tier). NOTIFY_EMAIL_ALWAYS=1 emails every held call.
# RESEND_API_KEY=
# NOTIFY_EMAIL_TO=
# NOTIFY_EMAIL_FROM=PayLeash <onboarding@resend.dev>
# NOTIFY_EMAIL_ALWAYS=0

# Plain-language policies use the same OpenAI-compatible model as the explanations (CF_ACCOUNT_ID / CF_API_TOKEN above).
# Without one, a rule-based parser handles common sentences.

# --- Demo agents (apps/demo-agents, `pnpm demo:agents`) ---
# By default they are scripted and need nothing. With a model configured (CF_ACCOUNT_ID / CF_API_TOKEN above, or LLM_BASE_URL / LLM_API_KEY / LLM_MODEL)
# the agents are driven by it (Vercel AI SDK tool loop). The model must support function calling.
# CF_AGENT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Against a running sandbox proxy: the dispute agent's mandate (`payleash mandate issue --file examples/mandate.dispute-agent.json`)
# PAYLEASH_MANDATE_DISPUTE=
